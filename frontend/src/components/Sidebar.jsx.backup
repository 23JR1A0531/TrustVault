import {
  LayoutDashboard,
  Files,
  Users,
  Building2,
  LogOut,
  ShieldCheck,
} from "lucide-react";

const menuItems = [
  { label: "Dashboard", icon: LayoutDashboard },
  { label: "Documents", icon: Files },
  { label: "Groups", icon: Users },
  { label: "Departments", icon: Building2 },
  { label: "Admin Dashboard", icon: ShieldCheck },
];

export default function Sidebar({ page, setPage, user, onLogout }) {
  return (
    <aside
      style={{
        width: 212,
        minWidth: 212,
        minHeight: "100vh",
        background: "#101a30",
        borderRight: "1px solid #26334d",
        color: "#f5f7ff",
        display: "flex",
        flexDirection: "column",
        boxSizing: "border-box",
      }}
    >
      <div
        style={{
          display: "flex",
          alignItems: "center",
          gap: 12,
          padding: "25px 20px 30px",
        }}
      >
        <div
          style={{
            width: 38,
            height: 38,
            borderRadius: 11,
            background: "#f5d477",
            color: "#101a30",
            display: "grid",
            placeItems: "center",
            fontSize: 20,
            fontWeight: 800,
          }}
        >
          T
        </div>

        <div>
          <div style={{ fontSize: 19, fontWeight: 750 }}>TrustVault</div>
          <div style={{ fontSize: 11, color: "#aab8d4", marginTop: 3 }}>
            Secure workspace
          </div>
        </div>
      </div>

      <div
        style={{
          padding: "0 24px 14px",
          fontSize: 10,
          fontWeight: 800,
          letterSpacing: 1.3,
          color: "#f5d477",
        }}
      >
        WORKSPACE
      </div>

      <nav style={{ padding: "0 14px", display: "grid", gap: 7 }}>
        {menuItems.map(({ label, icon: Icon }) => {
          const active =
            page === label ||
            (label === "Admin Dashboard" && page === "History");

          return (
            <button
              key={label}
              type="button"
              onClick={() => setPage(label)}
              style={{
                display: "flex",
                alignItems: "center",
                gap: 13,
                width: "100%",
                padding: "14px 13px",
                border: "none",
                borderRadius: 10,
                cursor: "pointer",
                textAlign: "left",
                color: active ? "#ffffff" : "#c1cbe0",
                background: active
                  ? "linear-gradient(100deg, #203e7c, #172e5c)"
                  : "transparent",
                boxShadow: active ? "inset 3px 0 #f5d477" : "none",
                fontSize: 13,
                fontWeight: active ? 700 : 500,
              }}
            >
              <Icon size={16} />
              <span>{label}</span>
            </button>
          );
        })}
      </nav>

      <div style={{ flex: 1 }} />

      <div
        style={{
          margin: "16px 14px 0",
          borderTop: "1px solid #293650",
          padding: "20px 5px",
        }}
      >
        <div
          style={{
            display: "flex",
            alignItems: "center",
            gap: 10,
            marginBottom: 22,
          }}
        >
          <div
            style={{
              width: 35,
              height: 35,
              borderRadius: "50%",
              display: "grid",
              placeItems: "center",
              background: "#24457e",
              border: "1px solid #5477bd",
              flexShrink: 0,
            }}
          >
            {(user?.name || user?.email || "U").charAt(0).toUpperCase()}
          </div>

          <div style={{ minWidth: 0 }}>
            <div
              style={{
                fontSize: 12,
                fontWeight: 700,
                overflow: "hidden",
                textOverflow: "ellipsis",
                whiteSpace: "nowrap",
              }}
            >
              {user?.name || user?.email || "User"}
            </div>
            <div style={{ fontSize: 10, color: "#aab8d4", marginTop: 4 }}>
              {user?.role || "User"}
            </div>
          </div>
        </div>

        <button
          type="button"
          onClick={onLogout}
          style={{
            display: "flex",
            alignItems: "center",
            gap: 9,
            padding: "8px 7px",
            background: "transparent",
            color: "#d0d8e9",
            border: "none",
            cursor: "pointer",
            fontSize: 12,
          }}
        >
          <LogOut size={15} />
          Sign out
        </button>
      </div>
    </aside>
  );
}